# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# this project uses pnpm (pnpm-lock.yaml) — ignore other package managers'
# lockfiles so a stray `npm install`/`yarn` doesn't get committed
package-lock.json
yarn.lock

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# app data: sqlite db + uploaded PDFs
/data/

# MCP server config — pins this project's own Supabase project_ref, same
# personal/this-machine-specific category as .env*/data/ above.
/.mcp.json

# typescript
*.tsbuildinfo
next-env.d.ts

# AI-agent tooling config (Claude Code/AGENTS.md) — internal to local
# development, not needed by anyone cloning the repo to run the app.
# AGENTS.md is also auto-regenerated by `next dev` itself.
AGENTS.md
CLAUDE.md
.claude/
